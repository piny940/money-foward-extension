{
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["dist/**", "release/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}
