  "scripts": {
    "dev": "webpack --config webpack.dev.js",
    "watch": "webpack --config webpack.dev.js --watch",
    "prod": "webpack --config webpack.prod.js",
    "typecheck": "tsc --noEmit",
    "mkdir:release": "npx mkdirp release",
    "prerelease": "run-s mkdir:release prod",
    "release": "node release $1",
    "lint-check": "yarn -s run prettier -c . && yarn -s run oxlint",
    "lint": "yarn -s run prettier --write . && yarn -s run oxlint --fix"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bestzip": "^4.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.0.0",
    "esbuild-loader": "^4.5.0",
    "mkdirp": "^3.0.1",
    "npm-run-all2": "^9.0.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.0.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "bootstrap": "5.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
